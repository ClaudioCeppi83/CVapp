{
	"hosting": {
		"site": "claudio-ceppi",
		"public": ".",
		"ignore": [
			"firebase.json",
			".firebaserc",
			"**/.*",
			"**/node_modules/**",
			"claudio ceppi/**",
			"assets/raw_developer_images/**",
			"package.json",
			"package-lock.json"
		],
		"cleanUrls": true,
		"trailingSlash": false,
		"headers": [
			{
				"source": "**/*.@(html|json)",
				"headers": [
					{
						"key": "Cache-Control",
						"value": "no-cache, no-store, must-revalidate"
					}
				]
			},
			{
				"source": "css/**",
				"headers": [
					{
						"key": "Cache-Control",
						"value": "public, max-age=31536000, immutable"
					}
				]
			},
			{
				"source": "js/**",
				"headers": [
					{
						"key": "Cache-Control",
						"value": "public, max-age=604800, stale-while-revalidate=86400"
					}
				]
			},
			{
				"source": "assets/**",
				"headers": [
					{
						"key": "Cache-Control",
						"value": "public, max-age=31536000, immutable"
					}
				]
			}
		]
	}
}
